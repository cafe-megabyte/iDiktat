{
  "sourceLanguage" : "en",
  "strings" : {
    "addKeyboardSteps" : {
      "comment" : "Instructions. Use the names of the iOS Settings screens in this language",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen → Allgemein → Tastatur → Tastaturen → Tastatur hinzufügen → iDiktat. Danach iDiktat antippen und „Vollen Zugriff erlauben“ einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings → General → Keyboard → Keyboards → Add New Keyboard → iDiktat. Then tap iDiktat and turn on “Allow Full Access”."
          }
        }
      }
    },
    "allowMicrophone" : {
      "comment" : "Button: asks for microphone permission",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon erlauben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Microphone"
          }
        }
      }
    },
    "allowMicrophoneFirst" : {
      "comment" : "Session message",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte zuerst den Mikrofonzugriff erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please allow microphone access first."
          }
        }
      }
    },
    "appModeFooter" : {
      "comment" : "Section footer in app mode",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App nimmt auf und erkennt im Hintergrund. Die Tastatur öffnet iDiktat beim ersten Diktieren automatisch. Danach zurückwechseln und erneut auf „Diktieren“ tippen. Solange die Sitzung läuft, ist das Mikrofon offen (oranger Punkt). Verarbeitet wird nur, was du zwischen „Diktieren“ und „Stopp“ sagst. Alles andere wird sofort verworfen und nie gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app records and recognizes in the background. The keyboard opens iDiktat automatically the first time you dictate. Then switch back and tap “Dictate” again. While the session runs, the microphone is open (orange dot). Only what you say between “Dictate” and “Stop” is processed. Everything else is discarded immediately and never stored."
          }
        }
      }
    },
    "checkNow" : {
      "comment" : "Button: opens the keyboard so it can confirm Full Access",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt prüfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Now"
          }
        }
      }
    },
    "checkingHint" : {
      "comment" : "Shown after tapping Check Now",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die iDiktat-Tastatur selbst kann ihren Zugriff bestätigen. Erscheint unten eine andere Tastatur, mit der Weltkugel auf iDiktat wechseln. Die Prüfung läuft dann automatisch. Beim nächsten Mal öffnet sich iDiktat hier direkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the iDiktat keyboard itself can confirm its access. If a different keyboard appears below, switch to iDiktat with the globe key. The check then runs automatically. Next time, iDiktat opens here directly."
          }
        }
      }
    },
    "endSession" : {
      "comment" : "Button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzung beenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End Session"
          }
        }
      }
    },
    "fullAccessLabel" : {
      "comment" : "Label of the Full Access state",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Zugriff"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Access"
          }
        }
      }
    },
    "fullAccessSteps" : {
      "comment" : "Instructions. Use the names of the iOS Settings screens in this language",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen → Allgemein → Tastatur → Tastaturen → iDiktat → „Vollen Zugriff erlauben“ einschalten. Danach hier auf „Jetzt prüfen“ tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings → General → Keyboard → Keyboards → iDiktat → turn on “Allow Full Access”. Then tap “Check Now” here."
          }
        }
      }
    },
    "fullAccessUnconfirmed" : {
      "comment" : "Full Access state",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht bestätigt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not confirmed yet"
          }
        }
      }
    },
    "hapticFeedbackSection" : {
      "comment" : "Section header",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastatur-Feedback"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard Feedback"
          }
        }
      }
    },
    "hapticFeedbackToggle" : {
      "comment" : "Toggle label",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haptisches Feedback"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haptic Feedback"
          }
        }
      }
    },
    "keyboardFooter" : {
      "comment" : "Section footer",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Zugriff ist nötig, damit die Tastatur das Mikrofon und die Verbindung zur App benutzen darf. iDiktat enthält keinen Netzwerk-Code: Sprache und Text bleiben auf dem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Access is required so the keyboard may use the microphone and the connection to the app. iDiktat contains no networking code: speech and text stay on your iPhone."
          }
        }
      }
    },
    "keyboardLabel" : {
      "comment" : "Label of the keyboard setup state",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastatur"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard"
          }
        }
      }
    },
    "keyboardModeFooter" : {
      "comment" : "Section footer in keyboard mode",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tastatur nimmt auf und erkennt selbst. Ohne App-Wechsel. Falls die Tastatur beim Diktieren plötzlich verschwindet, auf „In der App“ umschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keyboard records and recognizes by itself, without switching apps. If the keyboard suddenly disappears while dictating, switch to “In the App”."
          }
        }
      }
    },
    "keyboardNotAdded" : {
