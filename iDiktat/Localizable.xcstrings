      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sitzung wurde unterbrochen (z. B. durch einen Anruf). Bitte neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session was interrupted (e.g. by a call). Please start it again."
          }
