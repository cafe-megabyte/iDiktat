    "tryItHint" : {
      "comment" : "Hint below the test field. Dictate and Stop are the keyboard's button titles",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf „Diktieren“ tippen, sprechen (Deutsch, Englisch oder gemischt), dann „Stopp“."
          }
        },
        "en" : {
